        "logs/gatk_apply_bqsr/{roi}{sep}gatk-bqsr/{samplealias}.log",
    threads: 1
    shell:
        """
        gatk ApplyBQSR -bqsr {input.table} -I {input.bam} -O {output.recal} > {log} 2>&1
        """


