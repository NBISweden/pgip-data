        gatk AnalyzeCovariates --before-report-file {input.before} \
        --after-report-file {input.after} --plots-report-file {output.pdf} \
        --intermediate-csv-file {output.csv} > {log} 2>&1
        """


rule gatk_combine_gvcfs:
    """Run GATK CombineGVCFs"""
    output:
        vcf="{roi}{sep}gatk-combine-gvcf-{callmode}/{callset}.g.vcf.gz",
        tbi="{roi}{sep}gatk-combine-gvcf-{callmode}/{callset}.g.vcf.gz.tbi",
    input:
        vcf=lambda wildcards: gatk_combine_gvcfs_input(wildcards),
        tbi=lambda wildcards: gatk_combine_gvcfs_input(wildcards, True),
        ref=os.path.join("{roi}", "ref", config["reference"]),
    params:
        vcf=lambda wildcards, input: " ".join([f"-V {x}" for x in input.vcf]),
    conda:
        "envs/environment.yml"
    benchmark:
        "benchmarks/gatk_combine_gvcfs/{roi}{sep}gatk-combine-gvcf-{callmode}/{callset}.g.vcf.gz.benchmark.txt"
    log:
        "logs/gatk_combine_gvcfs/{roi}{sep}gatk-combine-gvcf-{callmode}/{callset}.g.vcf.gz.log",
    threads: 1
    shell:
        """
        gatk CombineGVCFs -OVI true --output {output.vcf} --reference {input.ref} {params.vcf} > {log} 2>&1
        """


