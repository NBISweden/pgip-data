        vcf="{roi}/gatk-genotype-gvcf-{callmode}/{callset}.{sites}.vcf.gz",
        tbi="{roi}/gatk-genotype-gvcf-{callmode}/{callset}.{sites}.vcf.gz.tbi",
    params:
        options=vcftools_filter_options,
    conda:
        "envs/environment.yml"
    benchmark:
        "benchmarks/vcftools_filter/{roi}/vcftools-filter-{callmode}/{callset}.{sites}.vcf.gz.benchmark.txt"
    log:
        "logs/vcftools_filter/{roi}/vcftools-filter-{callmode}/{callset}.{sites}.vcf.gz.log",
    threads: 1
    shell:
        """
        vcftools  --gzvcf {input.vcf} {params.options} --recode --stdout | bgzip -c > {output.vcf} 2>{log}
        bcftools index -t {output.vcf}
        """


