        """


rule gatk_base_recalibrator:
    """Recalibrate bases using raw variant calls as known sites"""
    output:
        table="{roi}{sep}gatk-bqsr/{samplealias}.table",
    input:
        bam="{roi}{sep}md/{samplealias}.bam",
        bai="{roi}{sep}md/{samplealias}.bai",
        known_sites=expand("{{roi}}{{sep}}gatk-hc-raw/{samplealias}.g.vcf.gz", samplealias=sampleinfo.SampleAlias.values),
        ref=os.path.join("{roi}", "ref", config["reference"]),
    params:
        known_sites=lambda wildcards, input: ' '.join([f'--known-sites {x}' for x in input.known_sites]),
    conda:
        "envs/environment.yml"
    benchmark:
        "benchmarks/gatk_base_recalibrator/{roi}{sep}gatk-bqsr/{samplealias}.table.benchmark.txt"
    log:
        "logs/gatk_base_recalibrator/{roi}{sep}gatk-bqsr/{samplealias}.table.log",
    threads: 1
    shell:
        """
        gatk BaseRecalibrator -I {input.bam} -R {input.ref} {params.known_sites} -O {output.table} > {log} 2>&1
        """


rule gatk_apply_bqsr:
    """Apply BQSR on input bam"""
    output:
        recal="{roi}{sep}gatk-bqsr/{samplealias}.bam",
        bai="{roi}{sep}gatk-bqsr/{samplealias}.bai",
    input:
