        options=csvtk_compile_vcftools_stats_options,
    conda:
        "envs/environment.yml"
    benchmark:
        "benchmarks/csvtk_compile_vcftools_stats/{roi}{sep}vcftools-{callmode}/{callset}.{sites}.{stat}.txt.benchmark.txt"
    log:
        "logs/csvtk_compile_vcftools_stats/{roi}{sep}vcftools-{callmode}/{callset}.{sites}.{stat}.txt.log",
    threads: 1
    shell:
        """
        csvtk fix -t -T {input.stat} | csvtk summary -t {params.options} > {output.tab} 2> {log}
        """


