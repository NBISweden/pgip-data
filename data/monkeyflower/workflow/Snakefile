rule gff_to_roi:
    """Convert annotation gff files to roi"""
    output:
        gff="{roi}/{prefix}.gff",
    input:
        gff="{prefix}.gff",
        bed="{roi}/bed/{roi}.bed",
        fasta=f"ref/{config['reference']}.genomebed.txt",
    conda:
        "envs/environment.yml",
    benchmark:
        "benchmarks/gff_to_roi/{roi}/{prefix}.gff.benchmark.txt",
    log:
        "logs/gff_to_roi/{roi}/{prefix}.gff.log",
    threads: 1
    shell:
        """
        bedtools intersect -a {input.gff} -b {input.bed} > {output.gff}
        """


rule bedtools_genome_file:
    """Make bedtools genome file"""
    output:
        txt="{prefix}.fasta.genomebed.txt",
    input:
        fasta="{prefix}.fasta",
    conda:
        "envs/environment.yml",
    benchmark: "benchmarks/bedtools_genome_file/{prefix}.fasta.genomebed.txt.benchmark.txt",
    log: "logs/bedtools_genome_file/{prefix}.fasta.genomebed.txt.log",
    threads: 1
    shell:
        """
        cut -f 1,2 {input.fasta} > {output.txt}
        """


