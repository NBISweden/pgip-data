rule gatk_haplotypecaller:
    """Run GATK HaplotypeCaller"""
    output:
        vcf="{roi}{sep}gatk-hc-{callmode}/{samplealias}{mode}.vcf.gz",
        tbi="{roi}{sep}gatk-hc-{callmode}/{samplealias}{mode}.vcf.gz.tbi",
    input:
        bam=lambda wildcards: "{roi}{sep}bam/{samplealias}.bam" if wildcards.callmode == "raw" else "{roi}{sep}gatk-bqsr/{samplealias}.bam",
        bai=lambda wildcards: "{roi}{sep}bam/{samplealias}.bam.bai" if wildcards.callmode == "raw" else "{roi}{sep}gatk-bqsr/{samplealias}.bai",
        ref=os.path.join("{roi}", "ref", config["reference"]),
        dict=get_sequence_dictionary,
        fai=get_sequence_fai,
    params:
        mode_options=lambda wildcards: "-ERC GVCF" if wildcards.mode == ".g" else "",
        options=" ".join(
            [
                "-A",
                "FisherStrand",
                "-A",
                "QualByDepth",
                "-A",
                "MappingQuality",
                "-G",
                "StandardAnnotation",
            ]
        ),
    wildcard_constraints:
        mode="(.g|)",
    conda:
        "envs/environment.yml"
    benchmark:
        "benchmarks/gatk_haplotypecaller/{roi}{sep}gatk-hc-{callmode}/{samplealias}{mode}.vcf.gz.benchmark.txt"
    log:
        "logs/gatk_haplotypecaller/{roi}{sep}gatk-hc-{callmode}/{samplealias}{mode}.vcf.gz.log",
    threads: 4
    shell:
        """
        gatk HaplotypeCaller -OVI true \
        {params.options} {params.mode_options} \
        --input {input.bam} --output {output.vcf} \
        --reference {input.ref} \
        --native-pair-hmm-threads {threads} > {log} 2>&1
        """


rule gatk_raw_or_bqsr_variant_filtration:
    """Filter raw or bqsr variants"""
    output:
        vcf="{roi}{sep}gatk-hc-filter-{callmode}/{samplealias}{mode}.vcf.gz",
        tbi="{roi}{sep}gatk-hc-filter-{callmode}/{samplealias}{mode}.vcf.gz.tbi",
