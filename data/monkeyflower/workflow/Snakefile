rule bcftools_view_variant_sites:
    """Generate variants only output file"""
    output:
        vcf="{roi}{sep}gatk-genotype-gvcf-{callmode}/{callset}.variantsites.vcf.gz",
        tbi="{roi}{sep}gatk-genotype-gvcf-{callmode}/{callset}.variantsites.vcf.gz.tbi",
    input:
        vcf="{roi}{sep}gatk-genotype-gvcf-{callmode}/{callset}.allsites.vcf.gz",
        tbi="{roi}{sep}gatk-genotype-gvcf-{callmode}/{callset}.allsites.vcf.gz.tbi",
    conda:
        "envs/environment.yml"
    benchmark:
        "benchmarks/bcftools_view_variant_sites/{roi}{sep}gatk-genotype-gvcf-{callmode}/{callset}.variantsites.vcf.gz.benchmark.txt"
    log:
        "logs/bcftools_view_variant_sites/{roi}{sep}gatk-genotype-gvcf-{callmode}/{callset}.variantsites.vcf.gz.log",
    threads: 1
    shell:
        """
        bcftools filter -i "QUAL>0" {input.vcf} | bcftools view -m 2 - -o {output.vcf} -O z 2>{log}
        bcftools index -t {output.vcf}
        """


rule vcflib_subset:
    """Subset"""
    output:
        vcf="{prefix}.subset.vcf.gz",
        tbi="{prefix}.subset.vcf.gz.tbi",
    input:
        vcf="{prefix}.vcf.gz",
        tbi="{prefix}.vcf.gz.tbi",
    params:
        samplesize=100000,
    conda:
        "envs/environment.yml"
    benchmark:
        "benchmarks/vcflib_subset/{prefix}.subset.vcf.gz.benchmark.txt"
    log:
        "logs/vcflib_subset/{prefix}.subset.vcf.gz.log",
    threads: 1
    shell:
        """
        nsamples=$(bcftools stats {input.vcf} | grep "number of records:" | cut -f 4);
        frac=$(echo {params.samplesize} / $nsamples | bc -l);
        bcftools view {input.vcf} | vcfrandomsample -r $frac | bgzip -c > {output.vcf}
        bcftools index -t {output.vcf}
        """


rule vcftools_stats:
    """Generate vcftools stats for callset"""
    output:
        stat="{roi}{sep}vcftools-{callmode}/{callset}.{sites}.{stat}",
    input:
        vcf="{roi}{sep}gatk-genotype-gvcf-{callmode}/{callset}.{sites}.vcf.gz",
        tbi="{roi}{sep}gatk-genotype-gvcf-{callmode}/{callset}.{sites}.vcf.gz.tbi",
    params:
        stat=vcftools_stats,
        options=vcftools_stats_options,
        out=lambda wildcards: f"{wildcards.roi}{wildcards.sep}vcftools-{wildcards.callmode}/{wildcards.callset}.{wildcards.sites}",
    conda:
        "envs/environment.yml"
    benchmark:
        "benchmarks/vcftools_stats/{roi}{sep}vcftools-{callmode}/{callset}.{sites}.{stat}.benchmark.txt"
    log:
        "logs/vcftools_stats/{roi}{sep}vcftools-{callmode}/{callset}.{sites}.{stat}.log",
    threads: 1
    shell:
        """
        vcftools --gzvcf {input.vcf} {params.stat} {params.options} --out {params.out} > {log} 2>&1
        """


rule vcftools_filter:
